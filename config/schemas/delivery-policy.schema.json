{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-42.dev/config/orchard/delivery-policy/1.0.0",
  "title": "Orchard delivery policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roles",
    "qualification",
    "authority",
    "limits"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_order",
        "conditional"
      ],
      "properties": {
        "required_order": {
          "const": [
            "evidence-researcher",
            "writer",
            "editor",
            "factual-verifier",
            "accessibility-reviewer",
            "final-reviewer"
          ]
        },
        "conditional": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assessments_changed",
            "diagrams_changed"
          ],
          "properties": {
            "assessments_changed": {
              "const": "assessment-reviewer"
            },
            "diagrams_changed": {
              "const": "diagram-reviewer"
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_age_days",
        "required_criteria"
      ],
      "properties": {
        "maximum_age_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "required_criteria": {
          "const": [
            "role-quality",
            "primary-source-fidelity",
            "planted-defects",
            "conflicting-evidence",
            "prompt-injection",
            "structured-output",
            "accessibility",
            "latency",
            "cost",
            "recovery"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents_may_grant_gate_authority",
        "agents_may_publish"
      ],
      "properties": {
        "agents_may_grant_gate_authority": {
          "const": false
        },
        "agents_may_publish": {
          "const": false
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_run",
        "per_item"
      ],
      "properties": {
        "per_run": {
          "$ref": "#/$defs/limits"
        },
        "per_item": {
          "$ref": "#/$defs/limits"
        }
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "duration_ms",
        "retries",
        "source_fetches",
        "item_count",
        "concurrency",
        "usd_spend"
      ],
      "properties": {
        "requests": {
          "$ref": "#/$defs/count"
        },
        "input_tokens": {
          "$ref": "#/$defs/count"
        },
        "output_tokens": {
          "$ref": "#/$defs/count"
        },
        "total_tokens": {
          "$ref": "#/$defs/count"
        },
        "duration_ms": {
          "$ref": "#/$defs/count"
        },
        "retries": {
          "$ref": "#/$defs/count"
        },
        "source_fetches": {
          "$ref": "#/$defs/count"
        },
        "item_count": {
          "$ref": "#/$defs/count"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "usd_spend": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
