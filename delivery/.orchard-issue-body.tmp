        SHub -->|"aggregate"| SResult["Result"]

        SHub -. "hub unavailable" .-> SStop["Whole workflow stops"]
        STwo -. "bad or late result" .-> SCheck["Validation (UNKNOWN if enforced)"]
        SCheck -->|"reject, retry, or degrade"| SContained["Branch failure contained (UNKNOWN)"]
        SCheck -. "accepted unchecked" .-> SResult
    end

    subgraph PIPE["B. Sequential pipeline"]
        direction LR
        PReq["Request"] --> POne["Step 1 agent"]
        POne --> PCOne["Checkpoint (UNKNOWN if enforced)"]
        PCOne --> PTwo["Step 2 agent"]
        PTwo --> PCTwo["Checkpoint (UNKNOWN if enforced)"]
        PCTwo --> PThree["Step 3 agent"]
        PThree --> PResult["Result"]

        POne -. "faulty output passes checkpoint" .-> PTwo
        PTwo -. "builds on the fault" .-> PThree
        PThree -. "fault reaches the end" .-> PBad["Corrupted result"]
        PCOne -->|"on failure: reject or repair (UNKNOWN)"| PContained["Propagation stopped (UNKNOWN)"]
    end

    subgraph MESH["C. Peer mesh"]
        direction LR
        MReq["Task enters mesh"] --> MA["Peer A"]
        MA <--> MB["Peer B"]
        MB <--> MC["Peer C"]
        MC <--> MA

        MA --> MBoundary["Boundary validation (UNKNOWN)"]
        MB --> MBoundary
