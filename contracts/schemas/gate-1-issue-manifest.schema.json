{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://project-42.dev/schemas/orchard/gate-1-issue-manifest/1.0.0",
    "title": "Orchard Gate 1 issue manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "gate",
        "run_id",
        "track",
        "batch",
        "full_manifest_digest",
        "batch_digest",
        "idempotency_key",
        "items"
    ],
    "properties": {
        "schema_version": {
            "const": "1.0.0"
        },
        "gate": {
            "const": "gate-1"
        },
        "run_id": {
            "$ref": "#/$defs/uuid"
        },
        "track": {
            "enum": [
                "track-1",
                "track-2"
            ]
        },
        "batch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "ordinal",
                "count",
                "item_count",
                "total_item_count",
                "maximum_size"
            ],
            "properties": {
                "ordinal": {
                    "type": "integer",
                    "minimum": 1
                },
                "count": {
                    "type": "integer",
                    "minimum": 1
                },
                "item_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                },
                "total_item_count": {
                    "type": "integer",
                    "minimum": 1
                },
                "maximum_size": {
                    "const": 20
                }
            }
        },
        "full_manifest_digest": {
            "$ref": "#/$defs/digest"
        },
        "batch_digest": {
            "$ref": "#/$defs/digest"
        },
        "idempotency_key": {
            "type": "string",
            "pattern": "^github:gate-1:[0-9a-fA-F-]{36}:sha256:[a-f0-9]{64}$"
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
                "$ref": "#/$defs/item"
            }
        }
    },
    "$defs": {
        "uuid": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "item_id",
                "item_revision",
                "proposal_digest",
                "category",
                "title",
                "rationale",
                "evidence_refs",
                "score",
                "target",
                "risks",
                "estimated_cost",
                "decision_state"
            ],
            "properties": {
                "item_id": {
                    "$ref": "#/$defs/uuid"
                },
                "item_revision": {
                    "type": "integer",
                    "minimum": 1
                },
                "proposal_digest": {
                    "$ref": "#/$defs/digest"
                },
                "category": {
                    "enum": [
                        "new-course",
                        "new-module",
                        "addition",
                        "update",
                        "correction",
                        "replacement",
                        "removal"
                    ]
                },
                "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                },
                "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                },
                "evidence_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                    }
                },
                "score": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "formula_version",
                        "value"
                    ],
                    "properties": {
                        "formula_version": {
                            "type": "string",
                            "minLength": 1
                        },
                        "value": {
                            "type": "number"
                        }
                    }
                },
                "target": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "repository",
                        "path"
                    ],
                    "properties": {
                        "repository": {
                            "const": "project42dev/project42-platform"
                        },
                        "path": {
                            "type": "string",
                            "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
                        }
                    }
                },
                "risks": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "maxLength": 1000
                    }
                },
                "estimated_cost": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "currency",
                        "amount"
                    ],
                    "properties": {
                        "currency": {
                            "const": "USD"
                        },
                        "amount": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                },
                "decision_state": {
                    "enum": [
                        "pending",
                        "approved",
                        "denied",
                        "deferred",
                        "changes-requested"
                    ]
                }
            }
        }
    }
}
