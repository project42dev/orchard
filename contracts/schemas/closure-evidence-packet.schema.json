{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-42.dev/schemas/orchard/closure-evidence-packet/1.0.0",
  "title": "Orchard closure evidence packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "run_id",
    "track",
    "item_id",
    "item_revision",
    "proposal_digest",
    "artifact_digest",
    "scope_digest",
    "handoff_chain_digest",
    "handoff_ids",
    "displayed_diff_digest",
    "prepared_tree_digest",
    "base_commit",
    "artifact_binding",
    "gate_1",
    "gate_2",
    "ado",
    "tests",
    "factual_evidence",
    "accessibility_evidence",
    "canonical_target",
    "pull_request",
    "publication_transaction_id",
    "protected_main_commit",
    "push_acknowledgement",
    "residual_risks",
    "rollback_reference",
    "prepared_at",
    "packet_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "packet_id": {
      "$ref": "#/$defs/uuid"
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "track": {
      "enum": [
        "track-1",
        "track-2"
      ]
    },
    "item_id": {
      "$ref": "#/$defs/uuid"
    },
    "item_revision": {
      "type": "integer",
      "minimum": 1
    },
    "proposal_digest": {
      "$ref": "#/$defs/digest"
    },
    "artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "scope_digest": {
      "$ref": "#/$defs/digest"
    },
    "handoff_chain_digest": {
      "$ref": "#/$defs/digest"
    },
    "handoff_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "displayed_diff_digest": {
      "$ref": "#/$defs/digest"
    },
    "prepared_tree_digest": {
      "$ref": "#/$defs/digest"
    },
    "base_commit": {
      "$ref": "#/$defs/gitsha"
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding_id",
        "idempotency_key",
        "run_id",
        "item_id",
        "item_revision",
        "artifact_digest",
        "final_handoff_id",
        "final_handoff_digest",
        "scope_digest",
        "occurred_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "binding_id": {
          "$ref": "#/$defs/uuid"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "$ref": "#/$defs/uuid"
        },
        "item_id": {
          "$ref": "#/$defs/uuid"
        },
        "item_revision": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "final_handoff_id": {
          "$ref": "#/$defs/uuid"
        },
        "final_handoff_digest": {
          "$ref": "#/$defs/digest"
        },
        "scope_digest": {
          "$ref": "#/$defs/digest"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "gate_1": {
      "$ref": "#/$defs/gateEvidence"
    },
    "gate_2": {
      "$ref": "#/$defs/gateEvidence"
    },
    "ado": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_key",
        "work_item_id"
      ],
      "properties": {
        "external_key": {
          "type": "string",
          "pattern": "^orchard:track-[12]:[0-9a-f-]{36}:r[1-9][0-9]*$"
        },
        "work_item_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "evidence_ref"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "passed"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "factual_evidence": {
      "$ref": "#/$defs/reviewEvidence"
    },
    "accessibility_evidence": {
      "$ref": "#/$defs/reviewEvidence"
    },
    "canonical_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "protected_branch"
      ],
      "properties": {
        "repository": {
          "enum": [
            "project42dev/project42-platform",
            "project42dev/project42-content"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
        },
        "protected_branch": {
          "const": "main"
        }
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "url"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/project42dev/(project42-platform|project42-content)/pull/[1-9][0-9]*$"
        }
      }
    },
    "publication_transaction_id": {
      "$ref": "#/$defs/uuid"
    },
    "protected_main_commit": {
      "$ref": "#/$defs/gitsha"
    },
    "push_acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit",
        "status",
        "acknowledged_at"
      ],
      "properties": {
        "repository": {
          "const": "project42dev/project42-platform"
        },
        "branch": {
          "const": "main"
        },
        "commit": {
          "$ref": "#/$defs/gitsha"
        },
        "status": {
          "const": "succeeded"
        },
        "acknowledged_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback_reference": {
      "type": "string",
      "minLength": 1
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time"
    },
    "packet_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitsha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "digest",
        "full_manifest_digest",
        "batch_digest"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/uuid"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "full_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "batch_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "reviewEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
